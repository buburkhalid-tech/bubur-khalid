# App Configuration
NEXT_PUBLIC_APP_NAME="Bubur Khalid"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Default Store Configuration
NEXT_PUBLIC_STORE_TIMEZONE="Asia/Jakarta"
